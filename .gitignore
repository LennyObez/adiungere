# Build output
/core/target/
**/target/
/web/dist/
/web/node_modules/
node_modules/
/apps/site/public/docs/
.gradle/
local.properties
*.hprof
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
/apps/linux/.flatpak-builder/
/apps/linux/build-dir/
/apps/windows/src-tauri/target/

# Gate output: one file per step, written by scripts/gate.sh
/.gate/

# The pinned external tools, fetched by scripts/fetch-tools.sh from tools/versions.toml
/.tools/

# What the fuzzer writes: its evolving corpus and any crashing input. The seeds come from the fixture
# builder at run time, and a crashing input is an artefact of a run, not a source.
/core/fuzz/corpus/
/core/fuzz/artifacts/
/core/fuzz/coverage/

# What mutation testing writes
/core/mutants.out/
/core/mutants.out.old/

# Runtime and caches
*.log
.cache/
.parcel-cache/
.playwright/
/web/test-results/
/web/playwright-report/

# Secrets and local configuration: never tracked.
# Signing and distribution material is listed by extension rather than by location, because the mistake this
# guards against is a key landing somewhere nobody expected.
.env
.env.*
!.env.example
.envrc
.direnv/

*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.mobileprovision
*.cer
*.crt
*.csr
id_rsa
id_dsa
id_ecdsa
id_ed25519
!**/*.pub

**/google-services.json
**/GoogleService-Info.plist

# Recordings. The reference clip carries satellite positions and a route, so no capture of any kind is
# tracked here. Test material is generated by the fixture builder, which writes into an ignored directory.
/core/fixtures/generated/
/core/fixtures/private/
*.MP4
*.mp4

# Working notes: deliberately untracked, see CONTRIBUTING.md
/.worklog/

# Operating system noise. Editor and tool configuration is a property of a working environment rather than
# of the product, and belongs in that environment's global excludes.
.DS_Store
Thumbs.db
*.swp
