# Build output
/core/target/
**/target/
/web/dist/
/web/node_modules/
node_modules/
/apps/site/public/docs/
.gradle/
local.properties
*.hprof
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
/apps/linux/.flatpak-builder/
/apps/linux/build-dir/
/apps/windows/src-tauri/target/

# Gate output: one file per step, written by scripts/gate.sh
/.gate/

# Runtime and caches
*.log
.cache/
.parcel-cache/
.playwright/
/web/test-results/
/web/playwright-report/

# Secrets and local configuration: never tracked.
# Signing and distribution material is listed by extension rather than by location, because the mistake this
# guards against is a key landing somewhere nobody expected.
.env
.env.*
!.env.example
.envrc
.direnv/

*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.mobileprovision
*.cer
*.crt
*.csr
id_rsa
id_dsa
id_ecdsa
id_ed25519
!**/*.pub

**/google-services.json
**/GoogleService-Info.plist

# Recordings. The reference clip carries satellite positions and a route, so no capture of any kind is
# tracked here. Test material is generated by the fixture builder, which writes into an ignored directory.
/core/fixtures/generated/
/core/fixtures/private/
*.MP4
*.mp4

# Working notes: deliberately untracked, see CONTRIBUTING.md
/.worklog/

# Assistant configuration, which is a property of a working session rather than of the product.
/CLAUDE.md
/.claude/

# Operating system and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
